# MongoDB
# Usa tu URI de MongoDB Atlas o local
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/vulnerable-colegio

# JWT Secret (genera uno fuerte en producción)
JWT_SECRET=tu_secreto_jwt_aqui

# Puerto del servidor
PORT=5000

# URLs permitidas por CORS (separadas por comas)
# Incluye tu dominio de frontend en producción
# Ejemplo: CLIENT_URL=https://mi-app.vercel.app,https://www.mi-app.com
CLIENT_URL=http://localhost:5173

# Entorno: development | production
NODE_ENV=development
