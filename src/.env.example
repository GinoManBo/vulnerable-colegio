# URL del backend API
# En producción, reemplaza con la URL pública de tu servidor
# Ejemplo: VITE_API_URL=https://mi-api.onrender.com/api
# Si dejas vacío o comentado, el frontend detectará automáticamente el entorno:
# - En localhost usará: http://localhost:5000/api
# - En producción usará: /api (mismo dominio)
VITE_API_URL=
